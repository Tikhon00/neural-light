{
  "name": "neural-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "playwright test",
    "bench": "tsx scripts/benchmark.ts",
    "native:build": "swift build --package-path native -c release",
    "native:test": "swift test --package-path native",
    "app:build": "bash scripts/build-app.sh",
    "verify": "npm run test && npm run build && npm run native:test",
    "test:integration": "node scripts/integration.mjs",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts playwright.config.ts",
    "app:package": "bash scripts/package-app.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@xyflow/react": "^12.9.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
